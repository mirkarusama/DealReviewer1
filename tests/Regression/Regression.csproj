<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test harness: compiles the same DealReview_code the UiPath project calls, then runs tests/cases.json. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS8632;CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../FileReaderTool/DealReview_code/**/*.cs" />
  </ItemGroup>
</Project>
